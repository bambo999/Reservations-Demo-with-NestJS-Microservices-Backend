  "compounds": [
    {
      "name": "Docker: Attach All Microservices",
      "configurations": [
        "Docker: Attach to Reservations (Port 9229)",
        "Docker: Attach to Auth (Port 9230)",
        "Docker: Attach to Payments (Port 9231)",
        "Docker: Attach to Notifications (Port 9232)"
      ]
    }
  ]
}
