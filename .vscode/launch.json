      "sourceMapPathOverrides": {
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///*": "${workspaceFolder}/*",
        "webpack://sleepr/./*": "${workspaceFolder}/*",
        "webpack://sleepr/*": "${workspaceFolder}/*",
        "/usr/src/app/*": "${workspaceFolder}/*"
      }
    },
