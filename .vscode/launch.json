{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker: Attach to Reservations (Port 9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "localhost",
      "restart": true,
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/usr/src/app",
      "sourceMapPathOverrides": {
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///*": "${workspaceFolder}/*",
        "webpack://sleepr/./*": "${workspaceFolder}/*",
        "webpack://sleepr/*": "${workspaceFolder}/*",
        "/usr/src/app/*": "${workspaceFolder}/*"
      }
    },
    {
      "name": "Docker: Attach to Auth (Port 9230)",
      "type": "node",
      "request": "attach",
